{
  "name": "recipe-backend",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "outbox:dev": "ts-node src/kafka/outboxProcessor.ts",
    "outbox:start": "node dist/kafka/outboxProcessor.js",
    "outbox:build": "tsc src/kafka/outboxProcessor.ts --outDir dist",
    "outbox:status": "ts-node src/utils/outboxMonitor.ts",
    "outbox:retry": "ts-node -e \"require('./src/utils/outboxMonitor').retryFailedEvents().then(console.log)\"",
    "outbox:cleanup": "ts-node -e \"require('./src/utils/outboxMonitor').cleanupOldSentEvents().then(console.log)\"",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "@clickhouse/client": "^1.11.2",
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.0.1",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "pm2": "^5.4.3",
    "sequelize": "^6.35.2",
    "socket.io": "^4.7.5",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.5",
    "@types/pg": "^8.15.4",
    "prisma": "^6.12.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
