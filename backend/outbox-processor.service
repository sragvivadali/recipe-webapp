[Unit]
Description=Recipe App Outbox Processor
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/path/to/your/recipe-app/backend
ExecStart=/usr/bin/node dist/kafka/outboxProcessor.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target 